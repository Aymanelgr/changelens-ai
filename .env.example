# Copy this file to .env and replace every value before running docker compose.
# .env is ignored by git: secrets must never enter the repository (NFR-012).

POSTGRES_USER=changelens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=changelens

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters

# First administrator, created at startup only if the user table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@demo.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-too

# Optional. A folder that already holds Ollama models, so they are not downloaded twice.
# OLLAMA_MODELS_DIR=D:/dev/cache/ollama/models

# Optional. The defaults are local models. LLM_PROVIDER=none turns the LLM off.
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# LLM_ALLOWED_MODELS=mistral:7b
# EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_MODEL=BAAI/bge-m3
